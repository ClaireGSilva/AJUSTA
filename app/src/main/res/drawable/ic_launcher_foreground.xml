    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54">
        <!-- Circular tailor's chalk measurement guide arc -->
        <path
            android:pathData="M 34,54 A 20,20 0 0,1 74,54"
            android:strokeWidth="1.5"
            android:strokeColor="#55E8C582"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Needle piercing through -->
        <path
            android:pathData="M 54,26 L 54,82"
            android:strokeWidth="2.2"
            android:strokeColor="#F7F5F0"
            android:strokeLineCap="round" />
        <!-- Needle eye -->
        <path
            android:pathData="M 54,30 L 54,36"
            android:strokeWidth="1.2"
            android:strokeColor="#262420"
            android:strokeLineCap="round" />

        <!-- Left scissor blade / A leg -->
        <path
            android:pathData="M 54,32 L 34,74"
            android:strokeWidth="3.5"
            android:strokeColor="#E8C582"
            android:strokeLineCap="round" />
        <!-- Right scissor blade / A leg -->
        <path
            android:pathData="M 54,32 L 74,74"
            android:strokeWidth="3.5"
            android:strokeColor="#E8C582"
            android:strokeLineCap="round" />

        <!-- Scissor handle left loop -->
        <path
            android:pathData="M 34,74 C 30,78 30,84 35,87 C 40,90 46,86 44,80 C 42,75 36,73 34,74 Z"
            android:strokeWidth="2.5"
            android:strokeColor="#E8C582"
            android:fillColor="#00000000" />
        <!-- Scissor handle right loop -->
        <path
            android:pathData="M 74,74 C 78,78 78,84 73,87 C 68,90 62,86 64,80 C 66,75 72,73 74,74 Z"
            android:strokeWidth="2.5"
            android:strokeColor="#E8C582"
            android:fillColor="#00000000" />

        <!-- Cross stitch line (forming crossbar of letter A) -->
        <path
            android:pathData="M 40,58 L 68,58"
            android:strokeWidth="2.5"
            android:strokeColor="#F7F5F0"
            android:strokeLineCap="round" />

        <!-- Scissor pivot screw -->
        <path
            android:pathData="M 54,54 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
            android:fillColor="#F7F5F0" />
